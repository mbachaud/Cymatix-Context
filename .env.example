# cymatix-context — environment variable reference
#
# Copy to `.env` and source before running cymatix:
#   set -a; source .env; set +a                # bash / WSL
#   for /F "tokens=*" %i in (.env) do set %i   # cmd
#
# Vars marked [REQUIRED] must be set; others are optional with sensible
# defaults. [DARK-SHIP] = wired but off-by-default (Phase 2 / experimental).
# [TEST-ONLY] = used by benchmarks/tests only, not server runtime.
# [LEGACY] = back-compat alias kept for older clients; prefer the modern name.
#
# Verified by grep against cymatix_context/, scripts/, benchmarks/, and the
# launcher .bat files on 2026-05-10. File:line citations on each var.


# ─── Attribution (4-layer identity contract) ─────────────────────────────────
# These tag every gene the server writes for cross-machine federation.
# See FEDERATION_LOCAL.md and cymatix_context/server.py:_resolve_default_attribution.

# CYMATIX_ORG: organization slug — top of the 4-layer attribution stack.
# Falls back to "local" when unset. Set per shell to group machines under
# a common operator (e.g. "swiftwing", "acme").                  [OPTIONAL]
CYMATIX_ORG=local
# src: cymatix_context/server.py:139, cymatix_context/mcp_server.py:277

# CYMATIX_DEVICE: device/PC label in the federation stack. Doubles as the
# hardware picker for ribosome inference: auto | cuda | rocm | mps | cpu.
# When unset, server falls back to CYMATIX_PARTY then socket.gethostname().
# Override one-shot via CYMATIX_DEVICE=cpu to force CPU on a GPU box.   [OPTIONAL]
CYMATIX_DEVICE=auto
# src: cymatix_context/hardware.py:40, cymatix_context/server.py:145, cymatix_context/mcp_server.py:279

# CYMATIX_USER: human operator handle (the "who is at the keyboard" layer).
# Falls back to getpass.getuser() when unset. Distinct from CYMATIX_AGENT — a
# user can run multiple agents (laude/raude/taude) from one login.   [OPTIONAL]
CYMATIX_USER=
# src: cymatix_context/server.py:161, cymatix_context/mcp_server.py:283

# CYMATIX_AGENT: AI persona writing genes (laude / raude / taude / gemini /
# openwebui / etc). When unset, ingests are tagged "manual / no AI persona."
# Pre-4-layer code overloaded this as the user handle; the server still
# honors that legacy fallback when only CYMATIX_AGENT is set.          [OPTIONAL]
CYMATIX_AGENT=
# src: cymatix_context/server.py:153, cymatix_context/mcp_server.py:285

# CYMATIX_AGENT_KIND: agent vendor/family axis — e.g. "claude-code", "gemini",
# "ollama-chat", "vscode". Falls back to CYMATIX_MCP_HOST when omitted.
# Drives dashboard chip rendering and capability tags.               [OPTIONAL]
CYMATIX_AGENT_KIND=
# src: cymatix_context/mcp_server.py:288, cymatix_context/mcp_server.py:969

# CYMATIX_PARTY_ID: party/device identifier for CWoLa session attribution and
# session-registry presence. Resolution order: CYMATIX_PARTY_ID > CYMATIX_DEVICE
# > CYMATIX_PARTY > socket.gethostname(). Set in cymatix.toml [server] also.   [OPTIONAL]
CYMATIX_PARTY_ID=
# src: cymatix_context/mcp_server.py:135, cymatix_context/mcp_server.py:280

# CYMATIX_MCP_HANDLE: stable handle for one MCP session in the live registry.
# Convention: laude (Claude Code), raude (claude.ai), taude (Cursor),
# gemini (Gemini CLI), openwebui (Open WebUI). Defaults to "mcp-<pid>"
# when unset — unique per process but anonymous.                     [OPTIONAL]
CYMATIX_MCP_HANDLE=
# src: cymatix_context/mcp_server.py:119, cymatix_context/mcp_server.py:966

# CYMATIX_MCP_HOST: MCP host/tool family — used as a capability tag
# ("host:claude-code") on the live registry chip. Defaults to "unknown"
# when unset, which the launcher heuristically remaps via VSCODE_PID
# / CURSOR_TRACE_ID detection.                                       [OPTIONAL]
CYMATIX_MCP_HOST=
# src: cymatix_context/mcp_server.py:968, cymatix_context/launcher/ide_fingerprint.py:37

# CYMATIX_PARTY: legacy alias for CYMATIX_DEVICE / CYMATIX_PARTY_ID. Still read
# for back-compat with pre-4-layer clients. Prefer CYMATIX_PARTY_ID.   [LEGACY]
CYMATIX_PARTY=
# src: cymatix_context/server.py:146, cymatix_context/mcp_server.py:281


# ─── Server / config ─────────────────────────────────────────────────────────

# CYMATIX_CONFIG: path to cymatix.toml. Default is "cymatix.toml" in cwd.   [OPTIONAL]
CYMATIX_CONFIG=cymatix.toml
# src: cymatix_context/config.py:521

# CYMATIX_GENOME_PATH: SQLite genome path — overrides [genome].path in
# cymatix.toml. Use with CYMATIX_USE_SHARDS=1 for a routing DB.           [OPTIONAL]
CYMATIX_GENOME_PATH=
# src: cymatix_context/config.py:611

# CYMATIX_SERVER_UPSTREAM: OpenAI-compatible upstream URL (Ollama / OpenAI /
# headroom). Overrides [server].upstream. Set automatically when the
# launcher routes through headroom.                                   [OPTIONAL]
CYMATIX_SERVER_UPSTREAM=
# src: cymatix_context/config.py:616, cymatix_context/launcher/app.py:328

# CYMATIX_SERVER_UPSTREAM_TIMEOUT: seconds for upstream chat completions.
# Overrides [server].upstream_timeout. Float.                         [OPTIONAL]
CYMATIX_SERVER_UPSTREAM_TIMEOUT=
# src: cymatix_context/config.py:618

# CYMATIX_TZ: IANA timezone for the /context timestamp_local field
# (e.g. 'America/Los_Angeles', 'Europe/Berlin'). Falls back to system tz.  [OPTIONAL]
CYMATIX_TZ=
# src: cymatix_context/server.py:85

# CYMATIX_MCP_URL: cymatix HTTP base URL the MCP shim talks to.           [OPTIONAL]
CYMATIX_MCP_URL=http://127.0.0.1:11437
# src: cymatix_context/mcp_server.py:108

# CYMATIX_MCP_TIMEOUT: per-request timeout (seconds) for the MCP shim.  [OPTIONAL]
CYMATIX_MCP_TIMEOUT=30
# src: cymatix_context/mcp_server.py:109

# CYMATIX_MCP_LOG_LEVEL: logging level for the MCP shim process.        [OPTIONAL]
CYMATIX_MCP_LOG_LEVEL=INFO
# src: cymatix_context/mcp_server.py:1020

# CYMATIX_URL: legacy MCP base URL. Read by cymatix_context/mcp/server.py
# (the deprecated stdio shim) and benchmark scripts. Prefer CYMATIX_MCP_URL. [LEGACY]
CYMATIX_URL=http://127.0.0.1:11437
# src: cymatix_context/mcp/server.py:45, cymatix_context/vault/cli.py:18

# CYMATIX_TIMEOUT: legacy MCP timeout. Prefer CYMATIX_MCP_TIMEOUT.        [LEGACY]
CYMATIX_TIMEOUT=30
# src: cymatix_context/mcp/server.py:46


# ─── Observability ───────────────────────────────────────────────────────────

# CYMATIX_OBSERVABILITY: master switch for the native observability sidecar
# (Prometheus, Tempo, Loki, Grafana, OTel Collector). Set to 0 / false / no
# / off to skip. Default ON when unset.                               [OPTIONAL]
CYMATIX_OBSERVABILITY=1
# src: cymatix_context/launcher/app.py:432

# CYMATIX_OTEL_ENABLED: turn on OTel SDK init in the FastAPI server.
# Default "0" (off). Set "1" to emit traces/metrics to the collector. [OPTIONAL]
CYMATIX_OTEL_ENABLED=1
# src: cymatix_context/telemetry.py:117

# CYMATIX_OTEL_ENDPOINT: OTLP gRPC endpoint for the collector.          [OPTIONAL]
CYMATIX_OTEL_ENDPOINT=localhost:4317
# src: cymatix_context/telemetry.py:149

# CYMATIX_OTEL_INSECURE: "1" for plain gRPC (dev-local), "0" for TLS.   [OPTIONAL]
CYMATIX_OTEL_INSECURE=1
# src: cymatix_context/telemetry.py:150

# CYMATIX_OTEL_SAMPLER_RATIO: trace sampler 0.0-1.0. 1.0 = sample every span. [OPTIONAL]
CYMATIX_OTEL_SAMPLER_RATIO=1.0
# src: cymatix_context/telemetry.py:152

# CYMATIX_OTEL_REDACT_QUERY: "1" hashes raw query strings in spans
# (privacy default). Set "0" to ship raw queries — local dev only.    [OPTIONAL]
CYMATIX_OTEL_REDACT_QUERY=1
# src: cymatix_context/telemetry.py:77


# ─── Headroom integration (proxy + dashboard) ────────────────────────────────

# CYMATIX_HEADROOM_ENABLED: master switch — overrides [headroom].enabled
# in cymatix.toml. Truthy ⇒ launcher adopts/spawns headroom on start.   [OPTIONAL]
CYMATIX_HEADROOM_ENABLED=
# src: cymatix_context/launcher/app.py:567

# CYMATIX_HEADROOM_AUTOSTART: spawn headroom proxy if nothing is already
# running on the configured port. Truthy ⇒ autostart.                 [OPTIONAL]
CYMATIX_HEADROOM_AUTOSTART=
# src: cymatix_context/launcher/app.py:566

# CYMATIX_HEADROOM_ROUTE_UPSTREAM_AUTO: auto-route cymatix's OpenAI-compatible
# chat upstream through headroom only when the upstream is non-local.
# Local Ollama stays direct; remote providers gain headroom's proxy layer. [OPTIONAL]
CYMATIX_HEADROOM_ROUTE_UPSTREAM_AUTO=
# src: cymatix_context/launcher/app.py:544

# CYMATIX_DISABLE_HEADROOM: kill-switch for A/B benchmarking — bypass the
# headroom bridge entirely. Truthy ⇒ headroom hooks return None.      [OPTIONAL]
CYMATIX_DISABLE_HEADROOM=
# src: cymatix_context/headroom_bridge.py:52


# ─── Feature toggles ─────────────────────────────────────────────────────────

# CYMATIX_BUDGET_ZONE: enable the 2026-04-14 budget-zone gene-cap spike.
# Clamps max_genes based on caller's incoming prompt token count.
# Zones (128k window): <25% none, 25-40% cap 12, 40-60% cap 6,
# 60-80% cap 3, 80%+ cap 1. Truthy ⇒ on.                              [OPTIONAL]
CYMATIX_BUDGET_ZONE=1
# src: cymatix_context/budget_zone.py:48

# CYMATIX_FILENAME_ANCHOR_ENABLED: Tier 0.5 filename-anchor scoring —
# boost candidates whose filename stem matches a query term. Off by
# default to preserve existing tier behaviour.                        [OPTIONAL]
CYMATIX_FILENAME_ANCHOR_ENABLED=
# src: cymatix_context/filename_anchor.py:134, cymatix_context/context_manager.py:460

# CYMATIX_LAYERED_FINGERPRINTS: Phase 2 claims-layer fingerprints (issue #8).
# Off by default. Set "1" to write the layered fingerprint table.     [DARK-SHIP]
CYMATIX_LAYERED_FINGERPRINTS=0
# src: cymatix_context/genome.py:2848

# CYMATIX_USE_SHARDS: open the genome via the sharded routing adapter
# instead of the single-file SQLite path. Off by default until cutover. [DARK-SHIP]
CYMATIX_USE_SHARDS=
# src: cymatix_context/shard_router.py:243, cymatix_context/sharding.py:299

# CYMATIX_WALKING_TIEBREAK: opt-in associative-graph ordering for
# tied-score retrieval. A/B benchmarking flag.                        [DARK-SHIP]
CYMATIX_WALKING_TIEBREAK=
# src: cymatix_context/tie_break.py:42

# CYMATIX_ABSTAIN_DISABLE: kill-switch for the abstain-tier (BROAD takes
# negative space). Set "1" to force off even when cymatix.toml enables it.   [OPTIONAL]
CYMATIX_ABSTAIN_DISABLE=
# src: cymatix_context/context_manager.py:1036

# CYMATIX_LAUNCHER_UPDATE_CHECK: 0 / false / no / off disables the
# launcher's periodic pip-update check. Default ON.                   [OPTIONAL]
CYMATIX_LAUNCHER_UPDATE_CHECK=1
# src: cymatix_context/launcher/update_check.py:85


# ─── mem_sync (background ingest daemon) ─────────────────────────────────────

# CYMATIX_MEM_SYNC_URL: cymatix base URL for the mem_sync daemon's HTTP client.
# Falls back to [mem_sync].cymatix_url in cymatix.toml.                   [OPTIONAL]
CYMATIX_MEM_SYNC_URL=
# src: scripts/run_mem_sync.py:73

# CYMATIX_MEM_SYNC_INTERVAL: poll interval (seconds) between ingests.   [OPTIONAL]
CYMATIX_MEM_SYNC_INTERVAL=
# src: scripts/run_mem_sync.py:77

# CYMATIX_MEM_SYNC_DIRS: pathsep-separated list of dirs to watch.       [OPTIONAL]
CYMATIX_MEM_SYNC_DIRS=
# src: scripts/run_mem_sync.py:80


# ─── Bench / test-only ───────────────────────────────────────────────────────

# CYMATIX_MODEL: downstream model id for benchmark scripts (qwen3:4b /
# qwen3:8b / gemma4:e4b / etc). Not read by the server runtime.       [TEST-ONLY]
CYMATIX_MODEL=
# src: benchmarks/bench_needle.py:268, benchmarks/bench_needle_1000.py:61

# CYMATIX_BENCH_REQUIRE_BM25_PARITY: gate the rag-vs-cymatix composition
# bench on BM25 parity with the reference set.                        [TEST-ONLY]
CYMATIX_BENCH_REQUIRE_BM25_PARITY=0
# src: benchmarks/bench_cymatix_rag_composition.py:768

# CYMATIX_SKIP_MONITOR: opt out of bench_needle_1000's monitor sidecar. [TEST-ONLY]
CYMATIX_SKIP_MONITOR=
# src: benchmarks/bench_needle_1000.py:867

# CYMATIX_FUSION_MODE_LABEL: label tag for skill-activation bench rows. [TEST-ONLY]
CYMATIX_FUSION_MODE_LABEL=additive
# src: benchmarks/bench_skill_activation.py:287


# ─────────────────────────────────────────────────────────────────────────────
# Consumed-by index (one-line summary per var)
#
#   CYMATIX_ABSTAIN_DISABLE              context_manager._build_abstain_signal kill-switch
#   CYMATIX_AGENT                        ingest attribution AI agent handle
#   CYMATIX_AGENT_KIND                   agent family axis (claude-code / gemini / ...)
#   CYMATIX_BENCH_REQUIRE_BM25_PARITY    bench_cymatix_rag_composition.py gate
#   CYMATIX_BUDGET_ZONE                  budget_zone.is_enabled — gene-cap spike
#   CYMATIX_CONFIG                       cymatix.toml path
#   CYMATIX_DEVICE                       hardware picker + device attribution
#   CYMATIX_DISABLE_HEADROOM             headroom_bridge kill-switch (A/B)
#   CYMATIX_FILENAME_ANCHOR_ENABLED      filename_anchor.is_enabled — Tier 0.5 toggle
#   CYMATIX_FUSION_MODE_LABEL            bench_skill_activation row label
#   CYMATIX_GENOME_PATH                  genome.path override
#   CYMATIX_HEADROOM_AUTOSTART           launcher autostart override
#   CYMATIX_HEADROOM_ENABLED             launcher headroom master switch
#   CYMATIX_HEADROOM_ROUTE_UPSTREAM_AUTO conditional upstream route through headroom
#   CYMATIX_LAUNCHER_UPDATE_CHECK        launcher self-update check toggle
#   CYMATIX_LAYERED_FINGERPRINTS         genome.py Phase 2 claims layer toggle
#   CYMATIX_MCP_HANDLE                   live MCP session handle for registry presence
#   CYMATIX_MCP_HOST                     MCP host/tool-family capability tag
#   CYMATIX_MCP_LOG_LEVEL                MCP shim logging level
#   CYMATIX_MCP_TIMEOUT                  MCP shim per-request timeout
#   CYMATIX_MCP_URL                      MCP shim → cymatix HTTP base URL
#   CYMATIX_MEM_SYNC_DIRS                mem_sync watch_dirs override
#   CYMATIX_MEM_SYNC_INTERVAL            mem_sync poll interval
#   CYMATIX_MEM_SYNC_URL                 mem_sync cymatix base URL
#   CYMATIX_MODEL                        bench downstream model id
#   CYMATIX_OBSERVABILITY                native observability sidecar opt-out
#   CYMATIX_ORG                          attribution org id
#   CYMATIX_OTEL_ENABLED                 OTel SDK init switch
#   CYMATIX_OTEL_ENDPOINT                OTLP gRPC endpoint
#   CYMATIX_OTEL_INSECURE                OTLP plain-gRPC switch
#   CYMATIX_OTEL_REDACT_QUERY            hash query strings in spans
#   CYMATIX_OTEL_SAMPLER_RATIO           trace sampler ratio
#   CYMATIX_PARTY                        legacy alias for CYMATIX_DEVICE / CYMATIX_PARTY_ID
#   CYMATIX_PARTY_ID                     CWoLa party id + session attribution
#   CYMATIX_SERVER_UPSTREAM              OpenAI-compatible upstream URL override
#   CYMATIX_SERVER_UPSTREAM_TIMEOUT      upstream chat-completions timeout
#   CYMATIX_SKIP_MONITOR                 bench_needle_1000 monitor opt-out
#   CYMATIX_TIMEOUT                      legacy MCP timeout
#   CYMATIX_TZ                           /context timestamp_local timezone
#   CYMATIX_URL                          legacy MCP base URL
#   CYMATIX_USE_SHARDS                   sharded genome adapter switch
#   CYMATIX_USER                         human participant handle
#   CYMATIX_WALKING_TIEBREAK             walking-tiebreak A/B flag
#
# (no CYMATIX_*_TOKEN / *_SECRET / *_KEY / *_API_KEY are read by the codebase
#  — admin-endpoint auth is not implemented as of 2026-05-10).
