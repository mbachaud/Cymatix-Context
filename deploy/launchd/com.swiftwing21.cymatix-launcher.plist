<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd plist for cymatix-launcher (macOS).

  Installs the cymatix supervisor + dashboard as a per-user LaunchAgent so
  it starts at login and is kept alive by launchd.

  Installation:

    1. Edit the ProgramArguments path below to point at the cymatix-launcher
       script in your environment. Common locations:
         - /usr/local/bin/cymatix-launcher          (Homebrew Python)
         - ~/.venvs/cymatix/bin/cymatix-launcher      (manual venv)
         - ~/Library/Python/3.12/bin/cymatix-launcher  (--user install)

    2. Copy this file to ~/Library/LaunchAgents/:
         cp deploy/launchd/com.swiftwing21.cymatix-launcher.plist \
            ~/Library/LaunchAgents/

    3. Load it:
         launchctl load ~/Library/LaunchAgents/com.swiftwing21.cymatix-launcher.plist

    4. Verify:
         launchctl list | grep cymatix-launcher
         tail -f ~/Library/Logs/cymatix-launcher.log

    5. Open http://127.0.0.1:11438/ in your browser.

  Uninstall:

    launchctl unload ~/Library/LaunchAgents/com.swiftwing21.cymatix-launcher.plist
    rm ~/Library/LaunchAgents/com.swiftwing21.cymatix-launcher.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swiftwing21.cymatix-launcher</string>

  <!-- Replace with the absolute path to your cymatix-launcher executable. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/cymatix-launcher</string>
    <string>--no-browser</string>
  </array>

  <!-- Start at login and keep alive on crash. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <!-- Throttle restarts after rapid crashes (10 seconds between attempts). -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- Inherit the user's PATH so Ollama and other CLI tools are reachable. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Logs land in ~/Library/Logs/. -->
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/cymatix-launcher.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/cymatix-launcher.err.log</string>

  <!-- Resource hygiene -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>1024</integer>
  </dict>
</dict>
</plist>
